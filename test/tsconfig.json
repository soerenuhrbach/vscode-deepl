{
	"ts-node": {
		"files": true
	},
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2019",
		"lib": ["es2019"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"vscode": ["mocks/vscode.ts"]
		},
		"types": ["node", "mocha"]
	},
	"include": ["**/*.ts", "**/*.d.ts", "../src/**/*.ts"]
}
